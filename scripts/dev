#!/usr/bin/env bash
# An asst to try changes on, cut off from the real one: a private session bus
# that cannot start the installed asstd, a dev asstd on it, and a local
# Radicale as the server. The real config, cache, keyring and Nextcloud are
# never touched.
#
#   scripts/dev up [--signed-out]  build, then Radicale, the bus and asstd (idempotent)
#   scripts/dev run CMD...         a command on the private bus
#   scripts/dev asst ARGS...       the dev CLI on it
#   scripts/dev window [ARGS...]   build, then the window on a hidden Hyprland workspace, unfocused
#   scripts/dev tray               a stand-in tray on the bus (scripts/sni-host.py), before window
#   scripts/dev steno              a stand-in steno on the bus (scripts/steno-host.py), printing what
#                                  Open meeting asks for to steno.log. The window's `steno` is always
#                                  this stand-in, so Open meeting starts it when it is not up
#   scripts/dev click ID ACTION    click a notification the stand-in server showed (notify.log)
#   scripts/dev drive COMMAND      a scripted click or key (Window::drive)
#   scripts/dev keys [MOD+]KEY...  real key presses to this instance's window, unfocused (Hyprland
#                                  send_shortcut, aimed by the window's pid): `keys Tab h i
#                                  SHIFT+Return CTRL+Return`. Goes to the main surface, so not
#                                  into an open popover (those don't take focus here), unless
#                                  `drive searchfocus` put the keyboard in its search field
#   scripts/dev snap FILE.png      the window as a PNG; snap-popover for the open popover
#   scripts/dev dump [FILE]        JSON state dump (default $DEV/dump.json; no FILE also prints it)
#   scripts/dev texts [FILE]       what the window, an open dialog and popover show, as JSON:
#                                  labels, entries, buttons, icons, tooltips, and whether each takes input
#                                  (default $DEV/texts.json)
#   scripts/dev seed               deterministic fixture tasks (asst add --source dev:<key>), a finished
#                                  list (Shipped) and an archived one (Parked)
#   scripts/dev reset              wipe this instance's state, then up and seed
#   scripts/dev down [--all]       stop this instance's window, tray, asstd and bus, found on its
#                                  bus, so other instances keep running. --all is the broom for
#                                  every instance: all debug asst-gtk and asstd, and Radicale.
#                                  The devel hyprctl window rule cannot be
#                                  dropped and stays until a config reload.
#
# ASST_DEV (default ~/.cache/asst-dev/<name>, name from ASST_DEV_NAME or
# "gui") holds the bus address, config and cache; the name is also the
# Radicale user, so instances don't share lists. The bus has a stand-in
# notification server (scripts/notify-host.py, printing to notify.log), and
# starts the dev window when a notification opens a task in it.
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
DEV="${ASST_DEV:-${XDG_CACHE_HOME:-$HOME/.cache}/asst-dev/${ASST_DEV_NAME:-gui}}"
RADICALE="${XDG_CACHE_HOME:-$HOME/.cache}/asst-dev/radicale"
BIN="$REPO/target/debug"

has_name() {
  gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
    --method org.freedesktop.DBus.NameHasOwner "$1" 2>/dev/null | grep -q true
}

# The debug binaries this harness runs. Always rebuilt on `up`/`window` so
# an edit cannot be invisible; a warm incremental is about a second.
build() {
  cargo build --manifest-path "$REPO/Cargo.toml" -p asstd -p asst -p asst-gtk
}

# Fixture tasks for `seed`: key, title, due, priority, repeat, optional
# plan placement as "HH:MM minutes" on today, optional source stamp,
# optional list (by name; else the inbox) and `done` to complete it.
# Empty fields are skipped. The source defaults to `dev:<key>`, which keeps
# a re-run from duplicating; the same keys own their plan slots. A
# `steno:` or `gh:` stamp gives the row an origin caption (the rest get
# none). Shipped ends with only done tasks (a finished list); Parked is
# archived by `archive_lists` and keeps one open task out of the views.
seed_list() {
  local past next_mon
  past="$(date -d '2 days ago' +%F)"
  next_mon="$(date -d 'next monday' +%F)"
  cat <<SEED
overdue|Pay the rent|$past|1||
today-bank|Call the bank|today|1||11:00 30
today-standup|Daily standup|today||every day|09:00 30
today-anki|Review flashcards|today|3||
soon-report|Write the report|tomorrow|2||14:00 60
someday-gym|Gym||||
week-meeting|Team meeting|$next_mon||every monday|
steno-notes|Send the meeting notes|||||steno:dev/notes
gh-issue|Fix the sync bug|||||gh:dev/1
shipped-first|Ship the first release||||||Shipped|done
shipped-docs|Write the release notes||||||Shipped|done
parked-idea|Think about a plugin API||||||Parked|
SEED
}

# Merge day-plan slots into window.toml. Slots listed on stdin as JSON
# objects {uid,date,start,duration} replace any slot with the same uid.
place_slots() {
  local toml="$DEV/config/asst/window.toml"
  mkdir -p "$(dirname "$toml")"
  uv run --no-project --with tomli-w python -c '
import json, sys, tomllib, tomli_w
from pathlib import Path
path = Path(sys.argv[1])
slots = json.load(sys.stdin)
drop = {s["uid"] for s in slots}
data = tomllib.loads(path.read_text()) if path.exists() else {}
data["plan"] = [s for s in data.get("plan", []) if s.get("uid") not in drop] + slots
path.write_text(tomli_w.dumps(data))
' "$toml"
}

# Put lists (by name) in window.toml's `archived`, as Archive in the window
# does. Like place_slots, for before the window runs: it rewrites the file
# whole from what it read, and a running window would write its own over it.
archive_lists() {
  local toml="$DEV/config/asst/window.toml"
  mkdir -p "$(dirname "$toml")"
  "$BIN/asst" --json lists | uv run --no-project --with tomli-w python -c '
import json, sys, tomllib, tomli_w
from pathlib import Path
path = Path(sys.argv[1])
want = {name.lower() for name in sys.argv[2:]}
hrefs = [l["href"] for l in json.load(sys.stdin) if l["name"].lower() in want]
data = tomllib.loads(path.read_text()) if path.exists() else {}
data["archived"] = sorted(set(data.get("archived", [])) | set(hrefs))
path.write_text(tomli_w.dumps(data))
' "$toml" "$@"
}

# Lists the fixtures go to, created on first seed.
seed_lists() {
  local have
  have="$("$BIN/asst" --json lists | python3 -c 'import json,sys; print("\n".join(l["name"].lower() for l in json.load(sys.stdin)))')"
  for name in Inbox Work Errands Shipped Parked; do
    grep -qx "$(echo "$name" | tr '[:upper:]' '[:lower:]')" <<<"$have" || "$BIN/asst" list new "$name"
  done
}

seed_tasks() {
  local slots="[]" key title due prio repeat plan source list done uid json
  local -a args
  while IFS='|' read -r key title due prio repeat plan source list done; do
    [ -n "$key" ] || continue
    args=(--json add --source "${source:-dev:$key}" --literal)
    if [ -n "$list" ]; then args+=(--list "$list"); fi
    if [ -n "$due" ]; then args+=(--due "$due"); fi
    if [ -n "$prio" ]; then args+=(--priority "$prio"); fi
    if [ -n "$repeat" ]; then args+=(--repeat "$repeat"); fi
    json="$("$BIN/asst" "${args[@]}" "$title")"
    uid="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["uid"])' <<<"$json")"
    # Only an open task: a re-run finds it done already.
    if [ -n "$done" ] && python3 -c 'import json,sys; sys.exit(0 if json.load(sys.stdin)["status"] == "needs-action" else 1)' <<<"$json"; then
      "$BIN/asst" --json done "$uid" > /dev/null
    fi
    if [ -n "$plan" ]; then
      slots="$(python3 -c '
import json, sys
uid, day, rest = sys.argv[1], sys.argv[2], sys.argv[3]
start_s, dur_s = rest.split()
h, m = start_s.split(":")
slots = json.loads(sys.stdin.read() or "[]")
slots.append({"uid": uid, "date": day, "start": int(h)*60+int(m), "duration": int(dur_s)})
print(json.dumps(slots))
' "$uid" "$(date +%F)" "$plan" <<<"$slots")"
    fi
  done < <(seed_list)
  place_slots <<<"$slots"
}

# Files older harness versions left in the instance dir. The live set is
# the bus file, the logs and session.conf, plus config/ state/ data/.
clear_stale() {
  local keep='^(bus|asstd\.log|window\.log|notify\.log|tray\.log|steno\.log|session\.log|session\.conf|dump\.json|texts\.json|up\.lock|bin|config|state|data)$'
  local f base
  for f in "$DEV"/* "$DEV"/.*; do
    [ -e "$f" ] || continue
    base="$(basename "$f")"
    [ "$base" = . ] || [ "$base" = .. ] && continue
    if ! [[ $base =~ $keep ]]; then
      rm -rf "$f"
    fi
  done
}

on_bus() {
  [ -f "$DEV/bus" ] || { echo "not up; run scripts/dev up" >&2; exit 1; }
  export DBUS_SESSION_BUS_ADDRESS
  DBUS_SESSION_BUS_ADDRESS="$(cat "$DEV/bus")"
  unset DBUS_SESSION_BUS_PID
  export XDG_CONFIG_HOME="$DEV/config" XDG_STATE_HOME="$DEV/state"
  has_name dev.jaeho.Asst.Daemon || { echo "the dev asstd is not on the private bus" >&2; exit 1; }
}

action() {
  on_bus
  gdbus call --session --dest dev.jaeho.Asst.Devel --object-path /dev/jaeho/Asst/Devel \
    --method org.gtk.Actions.Activate "$1" "[<'${2//\'/\\\'}'>]" "{}" > /dev/null
}

# The pid behind a name on this instance's bus, or nothing. This is how the
# instance's own window, asstd and stand-ins are told from the other
# instances': a window class or a pattern on a command line matches them all.
bus_pid() {
  [ -f "$DEV/bus" ] || return 0
  # The reply reads `(uint32 12345,)`.
  DBUS_SESSION_BUS_ADDRESS="$(cat "$DEV/bus")" gdbus call --session \
    --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
    --method org.freedesktop.DBus.GetConnectionUnixProcessID "$1" 2> /dev/null \
    | sed -n 's/^(uint32 \([0-9][0-9]*\),)$/\1/p' || true
}

# Ends the process owning NAME on this instance's bus, if it is a COMM, and
# waits for it to go so the next `up` does not meet a bus still closing.
stop_on_bus() {
  local pid _
  pid="$(bus_pid "$1")"
  [ -n "$pid" ] && [ "$(ps -o comm= -p "$pid")" = "$2" ] || return 0
  kill "$pid" 2> /dev/null || return 0
  for _ in $(seq 40); do kill -0 "$pid" 2> /dev/null || return 0; sleep 0.1; done
}

# The dev window's `steno`, first on its PATH: the stand-in, so Open meeting
# can never start the installed steno, which would listen and write the real
# meetings from a window on this bus.
steno_shim() {
  mkdir -p "$DEV/bin"
  cat > "$DEV/bin/steno" <<SHIM
#!/bin/sh
exec /usr/bin/python3 "$REPO/scripts/steno-host.py" "\$@" >> "$DEV/steno.log" 2>&1
SHIM
  chmod +x "$DEV/bin/steno"
}

radicale_up() {
  curl -s -o /dev/null http://127.0.0.1:5232/ && return
  mkdir -p "$RADICALE/data"
  cat > "$RADICALE/config" <<CONF
[server]
hosts = 127.0.0.1:5232
[auth]
type = none
[storage]
filesystem_folder = $RADICALE/data
[logging]
level = warning
CONF
  # 9>&-: do not inherit the up lock into the long-lived server.
  (setsid nohup uvx --from radicale radicale --config "$RADICALE/config" > "$RADICALE/log" 2>&1 9>&- &)
  for _ in $(seq 50); do curl -s -o /dev/null http://127.0.0.1:5232/ && return; sleep 0.2; done
  echo "Radicale did not start; see $RADICALE/log" >&2
  exit 1
}

# hyprctl follows HYPRLAND_INSTANCE_SIGNATURE, and a shell that outlived a
# Hyprland restart still exports the dead one. Keep the inherited one while
# it answers; else take the newest live instance, from `hyprctl instances`
# (which ignores the signature). One stderr line when it swaps or finds none.
live_hyprland() {
  hyprctl version > /dev/null 2>&1 && return 0
  local sig
  sig="$(hyprctl instances -j 2> /dev/null | python3 -c '
import json, sys
live = json.load(sys.stdin)
print(max(live, key=lambda i: i["time"])["instance"] if live else "")
' 2> /dev/null)" || true
  if [ -z "$sig" ]; then
    echo "scripts/dev: no live Hyprland (HYPRLAND_INSTANCE_SIGNATURE=${HYPRLAND_INSTANCE_SIGNATURE:-unset} is dead)" >&2
    return 1
  fi
  echo "scripts/dev: HYPRLAND_INSTANCE_SIGNATURE=${HYPRLAND_INSTANCE_SIGNATURE:-unset} is dead; using $sig" >&2
  export HYPRLAND_INSTANCE_SIGNATURE="$sig"
}

hide_window() {
  # Named rule, so a later `up` replaces it in place. There is no remove
  # or reset on hl.window_rule (the userdata has no methods, and the name
  # map only holds one rule per name), so this stays until Hyprland
  # reloads its config. `down --all` leaves it too; it matches only the
  # devel app id, so a normal asst window is unaffected. Without the rule
  # the window just opens unhidden, so a failure warns and `up` goes on.
  command -v hyprctl > /dev/null || return 0
  live_hyprland || return 0
  local out
  out="$(hyprctl eval 'hl.window_rule({ name = "asst-devel", match = { class = "^(dev.jaeho.Asst.Devel)$" }, workspace = "name:asstdev silent", no_initial_focus = true, render_unfocused = true, float = true, size = "1280 820" })' 2>&1)" \
    || echo "scripts/dev: the devel window rule is not set: $out" >&2
}

# The part that runs inside dbus-run-session.
inside() {
  echo "$DBUS_SESSION_BUS_ADDRESS" > "$DEV/bus"
  if gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
      --method org.freedesktop.DBus.ListActivatableNames | grep -Eq "'dev\.jaeho\.Asst(\.Daemon)?'"; then
    echo "refusing: this bus can start the installed asst" >&2
    exit 1
  fi
  /usr/bin/python3 "$REPO/scripts/notify-host.py" > "$DEV/notify.log" 2>&1 &
  for _ in $(seq 40); do has_name org.freedesktop.Notifications && break; sleep 0.1; done
  export XDG_CONFIG_HOME="$DEV/config" XDG_STATE_HOME="$DEV/state" ASST_PASSWORD=x ASST_DEVEL=1
  "$BIN/asstd" > "$DEV/asstd.log" 2>&1 &
  wait
}

case "${1:-}" in
  up)
    # One bring-up at a time: a second `up` waits here instead of
    # stacking a second bus and asstd on the same instance dir.
    mkdir -p "$DEV"
    exec 9>"$DEV/up.lock"
    flock 9
    # Build first even when already up: the bus may be live with last
    # build's binaries. Bring-up itself stays idempotent below.
    build
    if [ -f "$DEV/bus" ] && (on_bus) 2>/dev/null; then exit 0; fi
    radicale_up
    mkdir -p "$DEV/config/asst" "$DEV/state" "$DEV/data"
    if [ "${2:-}" = "--signed-out" ]; then
      : > "$DEV/config/asst/config.toml"
    else
      cat > "$DEV/config/asst/config.toml" <<CONF
[account]
server = "http://127.0.0.1:5232"
dav_url = "http://127.0.0.1:5232/"
username = "$(basename "$DEV")"
home = "/$(basename "$DEV")/"
CONF
    fi
    rm -f "$DEV/bus"
    steno_shim
    # What a click on a reminder starts when the dev window isn't running.
    mkdir -p "$DEV/data/dbus-1/services"
    cat > "$DEV/data/dbus-1/services/dev.jaeho.Asst.Devel.service" <<SERVICE
[D-BUS Service]
Name=dev.jaeho.Asst.Devel
Exec=/usr/bin/env -u XDG_DATA_HOME XDG_DATA_DIRS=/usr/local/share:/usr/share XDG_CONFIG_HOME=$DEV/config XDG_STATE_HOME=$DEV/state PATH=$DEV/bin:$PATH ASST_DEVEL=1 ASST_NO_AUTOHIDE=1 GTK_A11Y=none GDK_DEBUG=no-portals $BIN/asst-gtk --gapplication-service
SERVICE
    hide_window
    # A bus that only starts this instance's services. Pointing
    # XDG_DATA_DIRS away is not enough: standard_session_servicedirs still
    # opens /usr/share and ~/.local, where a real install's units live.
    cat > "$DEV/session.conf" <<CONF
<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
  <type>session</type>
  <listen>unix:tmpdir=/tmp</listen>
  <auth>EXTERNAL</auth>
  <policy context="default">
    <allow send_destination="*" eavesdrop="true"/>
    <allow eavesdrop="true"/>
    <allow own="*"/>
  </policy>
  <servicedir>$DEV/data/dbus-1/services</servicedir>
</busconfig>
CONF
    # 9>&-: the bus and asstd outlive `up`; they must not hold its lock.
    (setsid nohup dbus-run-session --config-file="$DEV/session.conf" \
      -- "$0" inside > "$DEV/session.log" 2>&1 9>&- &)
    for _ in $(seq 50); do
      if [ -f "$DEV/bus" ] && (on_bus) 2>/dev/null; then echo "up: $DEV"; exit 0; fi
      sleep 0.2
    done
    echo "did not come up; see $DEV/session.log and $DEV/asstd.log" >&2
    exit 1
    ;;
  inside) inside ;;
  run) shift; on_bus; exec "$@" ;;
  asst) shift; on_bus; exec "$BIN/asst" "$@" ;;
  window)
    shift
    build
    on_bus
    # Only this instance's old window: a pattern would take the others'.
    stop_on_bus dev.jaeho.Asst.Devel asst-gtk
    hide_window
    steno_shim
    # Popovers stay open without keyboard focus (ASST_NO_AUTOHIDE).
    (env ASST_DEVEL=1 ASST_NO_AUTOHIDE=1 GTK_A11Y=none GDK_DEBUG=no-portals PATH="$DEV/bin:$PATH" \
      setsid "$BIN/asst-gtk" "$@" > "$DEV/window.log" 2>&1 &)
    for _ in $(seq 60); do has_name dev.jaeho.Asst.Devel && { sleep 1; exit 0; }; sleep 0.25; done
    echo "the window did not come up; see $DEV/window.log" >&2
    exit 1
    ;;
  tray)
    on_bus
    has_name org.kde.StatusNotifierWatcher && exit 0
    (setsid /usr/bin/python3 "$REPO/scripts/sni-host.py" > "$DEV/tray.log" 2>&1 &)
    for _ in $(seq 40); do has_name org.kde.StatusNotifierWatcher && exit 0; sleep 0.1; done
    echo "the stand-in tray did not come up; see $DEV/tray.log" >&2
    exit 1
    ;;
  steno)
    on_bus
    has_name dev.jaeho.Steno && exit 0
    steno_shim
    (setsid "$DEV/bin/steno" gui --background > /dev/null 2>&1 &)
    for _ in $(seq 40); do has_name dev.jaeho.Steno && exit 0; sleep 0.1; done
    echo "the stand-in steno did not come up; see $DEV/steno.log" >&2
    exit 1
    ;;
  drive) action drive "$2" ;;
  click)
    on_bus
    gdbus call --session --dest org.freedesktop.Notifications --object-path /org/freedesktop/Notifications \
      --method dev.jaeho.Test.Click "$2" "$3" > /dev/null
    ;;
  keys)
    shift
    live_hyprland || exit 1
    # Every instance's window has the devel class, so the class would send
    # the keys to all of them: aim at this instance's window by its pid.
    pid="$(bus_pid dev.jaeho.Asst.Devel)"
    [ -n "$pid" ] || { echo "no window on this instance's bus; run scripts/dev window" >&2; exit 1; }
    for k in "$@"; do
      mods="" key="$k"
      case "$k" in *+*) mods="${k%+*}"; key="${k##*+}"; mods="${mods//+/ }" ;; esac
      hyprctl eval "hl.dispatch(hl.dsp.send_shortcut({mods=\"${mods}\", key=\"${key}\", window=\"pid:${pid}\"}))" > /dev/null
      sleep 0.05
    done
    ;;
  snap) action snapshot "$(realpath -m "$2")" ;;
  snap-popover) action snapshot-popover "$(realpath -m "$2")" ;;
  dump)
    on_bus
    out="$(realpath -m "${2:-$DEV/dump.json}")"
    rm -f "$out"
    action dump "$out"
    # The action only queues the write on the GTK loop.
    for _ in $(seq 40); do [ -f "$out" ] && break; sleep 0.05; done
    [ -f "$out" ] || { echo "dump did not write $out; see $DEV/window.log" >&2; exit 1; }
    [ -n "${2:-}" ] || cat "$out"
    ;;
  texts)
    on_bus
    out="$(realpath -m "${2:-$DEV/texts.json}")"
    rm -f "$out"
    action texts "$out"
    for _ in $(seq 40); do [ -f "$out" ] && break; sleep 0.05; done
    [ -f "$out" ] || { echo "texts did not write $out; see $DEV/window.log" >&2; exit 1; }
    [ -n "${2:-}" ] || cat "$out"
    ;;
  seed)
    on_bus
    seed_lists
    seed_tasks
    archive_lists Parked
    ;;
  reset)
    # Not `down --all`: Radicale and the other instances stay as they are.
    "$0" down
    # window.toml and the copies the window keeps beside it (.v0 before a
    # migration, .bad for a file it could not read): a leftover would pass
    # for the next run's, and a stale .v0 makes back_up_v0 skip a real backup.
    rm -f "$DEV/config/asst/window.toml" "$DEV/config/asst/window.toml.v0" \
      "$DEV/config/asst/window.toml.bad" "$DEV"/state/asst/asst.db*
    # This instance's CalDAV collection only; other instances share Radicale.
    rm -rf "$RADICALE/data/collection-root/$(basename "$DEV")"
    clear_stale
    "$0" up
    "$0" seed
    ;;
  down)
    # Only what this instance runs, found by the names it owns on its bus.
    # A pattern on the command line matches every instance's, and every
    # worktree's, copy of the same binary. Asstd goes last: it and the
    # notification stand-in are what keep the bus up.
    stop_on_bus dev.jaeho.Asst.Devel asst-gtk
    stop_on_bus dev.jaeho.Steno python3
    stop_on_bus org.kde.StatusNotifierWatcher python3
    stop_on_bus org.freedesktop.Notifications python3
    stop_on_bus dev.jaeho.Asst.Daemon asstd
    if [ "${2:-}" = "--all" ]; then
      # Every instance's stray debug binaries, and Radicale, which they
      # share. The window rule from hide_window cannot be dropped (see its
      # comment); it only matches the devel app id and dies with a
      # Hyprland config reload.
      pkill -f "$BIN/asst-gtk" 2>/dev/null || true
      pkill -f "$BIN/asstd" 2>/dev/null || true
      pkill -f "target/debug/asst-gtk" 2>/dev/null || true
      pkill -f "target/debug/asstd" 2>/dev/null || true
      pkill -f "^/usr/bin/python3 $REPO/scripts/(sni|notify|steno)-host.py( |$)" 2>/dev/null || true
      pkill -f "$RADICALE/config" 2>/dev/null || true
    fi
    rm -f "$DEV/bus"
    ;;
  *) sed -n '2,/^[^#]/{/^#/p}' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
