#!/usr/bin/env bash
# An asst to try changes on, cut off from the real one: a private session bus
# that cannot start the installed asstd, a dev asstd on it, and a local
# Radicale as the server. The real config, cache, keyring and Nextcloud are
# never touched.
#
#   scripts/dev up [--signed-out]  build, then Radicale, the bus and asstd (idempotent)
#   scripts/dev run CMD...         a command on the private bus
#   scripts/dev asst ARGS...       the dev CLI on it
#   scripts/dev window [ARGS...]   build, then the window on a hidden Hyprland workspace, unfocused
#   scripts/dev tray               a stand-in tray on the bus (scripts/sni-host.py), before window
#   scripts/dev click ID ACTION    click a notification the stand-in server showed (notify.log)
#   scripts/dev drive COMMAND      a scripted click or key (Window::drive)
#   scripts/dev keys [MOD+]KEY...  real key presses to the window, unfocused (Hyprland send_shortcut):
#                                  `keys Tab h i SHIFT+Return CTRL+Return`. Goes to the main
#                                  surface, so not into an open popover (those don't take focus here)
#   scripts/dev snap FILE.png      the window as a PNG; snap-popover for the open popover
#   scripts/dev dump [FILE]        JSON state dump (default $DEV/dump.json; no FILE also prints it)
#   scripts/dev texts [FILE]       what the window, an open dialog and popover show, as JSON:
#                                  labels, entries, buttons, icons, tooltips (default $DEV/texts.json)
#   scripts/dev seed               deterministic fixture tasks (asst add --source dev:<key>)
#   scripts/dev reset              wipe this instance's state, then up and seed
#   scripts/dev down [--all]       stop the window, the tray, asstd and the bus;
#                                  --all also Radicale and stray target/debug bins.
#                                  The devel hyprctl window rule cannot be
#                                  dropped and stays until a config reload.
#
# ASST_DEV (default ~/.cache/asst-dev/<name>, name from ASST_DEV_NAME or
# "gui") holds the bus address, config, cache and notes folder; the name is also the
# Radicale user, so instances don't share lists. The bus has a stand-in
# notification server (scripts/notify-host.py, printing to notify.log), and
# starts the dev window when a notification opens a task in it.
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
DEV="${ASST_DEV:-${XDG_CACHE_HOME:-$HOME/.cache}/asst-dev/${ASST_DEV_NAME:-gui}}"
RADICALE="${XDG_CACHE_HOME:-$HOME/.cache}/asst-dev/radicale"
BIN="$REPO/target/debug"

has_name() {
  gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
    --method org.freedesktop.DBus.NameHasOwner "$1" 2>/dev/null | grep -q true
}

# The debug binaries this harness runs. Always rebuilt on `up`/`window` so
# an edit cannot be invisible; a warm incremental is about a second.
build() {
  cargo build --manifest-path "$REPO/Cargo.toml" -p asstd -p asst -p asst-gtk
}

# Fixture tasks for `seed`: key, title, due, priority, repeat, optional
# plan placement as "HH:MM minutes" on today. Empty fields are skipped.
# `--source dev:<key>` keeps a re-run from duplicating; the same keys own
# their plan slots.
seed_list() {
  local past next_mon
  past="$(date -d '2 days ago' +%F)"
  next_mon="$(date -d 'next monday' +%F)"
  cat <<SEED
overdue|Pay the rent|$past|1||
today-bank|Call the bank|today|1||11:00 30
today-standup|Daily standup|today||every day|09:00 30
today-anki|Review flashcards|today|3||
soon-report|Write the report|tomorrow|2||14:00 60
someday-gym|Gym||||
week-meeting|Team meeting|$next_mon||every monday|
SEED
}

# Merge day-plan slots into window.toml. Slots listed on stdin as JSON
# objects {uid,date,start,duration} replace any slot with the same uid.
place_slots() {
  local toml="$DEV/config/asst/window.toml"
  mkdir -p "$(dirname "$toml")"
  uv run --no-project --with tomli-w python -c '
import json, sys, tomllib, tomli_w
from pathlib import Path
path = Path(sys.argv[1])
slots = json.load(sys.stdin)
drop = {s["uid"] for s in slots}
data = tomllib.loads(path.read_text()) if path.exists() else {}
data["plan"] = [s for s in data.get("plan", []) if s.get("uid") not in drop] + slots
path.write_text(tomli_w.dumps(data))
' "$toml"
}

# Lists the fixtures go to, created on first seed.
seed_lists() {
  local have
  have="$("$BIN/asst" --json lists | python3 -c 'import json,sys; print("\n".join(l["name"].lower() for l in json.load(sys.stdin)))')"
  for name in Inbox Work Errands; do
    grep -qx "$(echo "$name" | tr '[:upper:]' '[:lower:]')" <<<"$have" || "$BIN/asst" list new "$name"
  done
}

seed_tasks() {
  local slots="[]" key title due prio repeat plan uid json
  local -a args
  while IFS='|' read -r key title due prio repeat plan; do
    [ -n "$key" ] || continue
    args=(--json add --source "dev:$key" --literal)
    if [ -n "$due" ]; then args+=(--due "$due"); fi
    if [ -n "$prio" ]; then args+=(--priority "$prio"); fi
    if [ -n "$repeat" ]; then args+=(--repeat "$repeat"); fi
    json="$("$BIN/asst" "${args[@]}" "$title")"
    uid="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["uid"])' <<<"$json")"
    if [ -n "$plan" ]; then
      slots="$(python3 -c '
import json, sys
uid, day, rest = sys.argv[1], sys.argv[2], sys.argv[3]
start_s, dur_s = rest.split()
h, m = start_s.split(":")
slots = json.loads(sys.stdin.read() or "[]")
slots.append({"uid": uid, "date": day, "start": int(h)*60+int(m), "duration": int(dur_s)})
print(json.dumps(slots))
' "$uid" "$(date +%F)" "$plan" <<<"$slots")"
    fi
  done < <(seed_list)
  place_slots <<<"$slots"
}

# Files older harness versions left in the instance dir. The live set is
# the bus file, the logs and session.conf, plus config/ state/ data/ notes/.
clear_stale() {
  local keep='^(bus|asstd\.log|window\.log|notify\.log|tray\.log|session\.log|session\.conf|dump\.json|texts\.json|up\.lock|config|state|data|notes)$'
  local f base
  for f in "$DEV"/* "$DEV"/.*; do
    [ -e "$f" ] || continue
    base="$(basename "$f")"
    [ "$base" = . ] || [ "$base" = .. ] && continue
    if ! [[ $base =~ $keep ]]; then
      rm -rf "$f"
    fi
  done
}

on_bus() {
  [ -f "$DEV/bus" ] || { echo "not up; run scripts/dev up" >&2; exit 1; }
  export DBUS_SESSION_BUS_ADDRESS
  DBUS_SESSION_BUS_ADDRESS="$(cat "$DEV/bus")"
  unset DBUS_SESSION_BUS_PID
  export XDG_CONFIG_HOME="$DEV/config" XDG_STATE_HOME="$DEV/state"
  has_name dev.jaeho.Asst.Daemon || { echo "the dev asstd is not on the private bus" >&2; exit 1; }
}

action() {
  on_bus
  gdbus call --session --dest dev.jaeho.Asst.Devel --object-path /dev/jaeho/Asst/Devel \
    --method org.gtk.Actions.Activate "$1" "[<'${2//\'/\\\'}'>]" "{}" > /dev/null
}

radicale_up() {
  curl -s -o /dev/null http://127.0.0.1:5232/ && return
  mkdir -p "$RADICALE/data"
  cat > "$RADICALE/config" <<CONF
[server]
hosts = 127.0.0.1:5232
[auth]
type = none
[storage]
filesystem_folder = $RADICALE/data
[logging]
level = warning
CONF
  # 9>&-: do not inherit the up lock into the long-lived server.
  (setsid nohup uvx --from radicale radicale --config "$RADICALE/config" > "$RADICALE/log" 2>&1 9>&- &)
  for _ in $(seq 50); do curl -s -o /dev/null http://127.0.0.1:5232/ && return; sleep 0.2; done
  echo "Radicale did not start; see $RADICALE/log" >&2
  exit 1
}

hide_window() {
  # Named rule, so a later `up` replaces it in place. There is no remove
  # or reset on hl.window_rule (the userdata has no methods, and the name
  # map only holds one rule per name), so this stays until Hyprland
  # reloads its config. `down --all` leaves it too; it matches only the
  # devel app id, so a normal asst window is unaffected.
  if command -v hyprctl > /dev/null; then
    hyprctl eval 'hl.window_rule({ name = "asst-devel", match = { class = "^(dev.jaeho.Asst.Devel)$" }, workspace = "name:asstdev silent", no_initial_focus = true, render_unfocused = true, float = true, size = "1280 820" })' > /dev/null
  fi
}

# The part that runs inside dbus-run-session.
inside() {
  echo "$DBUS_SESSION_BUS_ADDRESS" > "$DEV/bus"
  if gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
      --method org.freedesktop.DBus.ListActivatableNames | grep -Eq "'dev\.jaeho\.Asst(\.Daemon)?'"; then
    echo "refusing: this bus can start the installed asst" >&2
    exit 1
  fi
  /usr/bin/python3 "$REPO/scripts/notify-host.py" > "$DEV/notify.log" 2>&1 &
  for _ in $(seq 40); do has_name org.freedesktop.Notifications && break; sleep 0.1; done
  export XDG_CONFIG_HOME="$DEV/config" XDG_STATE_HOME="$DEV/state" ASST_PASSWORD=x ASST_DEVEL=1
  "$BIN/asstd" > "$DEV/asstd.log" 2>&1 &
  wait
}

case "${1:-}" in
  up)
    # One bring-up at a time: a second `up` waits here instead of
    # stacking a second bus and asstd on the same instance dir.
    mkdir -p "$DEV"
    exec 9>"$DEV/up.lock"
    flock 9
    # Build first even when already up: the bus may be live with last
    # build's binaries. Bring-up itself stays idempotent below.
    build
    if [ -f "$DEV/bus" ] && (on_bus) 2>/dev/null; then exit 0; fi
    radicale_up
    mkdir -p "$DEV/config/asst" "$DEV/state" "$DEV/data" "$DEV/notes"
    # Never the default, which is the real ~/Nextcloud/Notes.
    if [ "${2:-}" = "--signed-out" ]; then
      echo "notes = \"$DEV/notes\"" > "$DEV/config/asst/config.toml"
    else
      cat > "$DEV/config/asst/config.toml" <<CONF
notes = "$DEV/notes"

[account]
server = "http://127.0.0.1:5232"
dav_url = "http://127.0.0.1:5232/"
username = "$(basename "$DEV")"
home = "/$(basename "$DEV")/"
CONF
    fi
    rm -f "$DEV/bus"
    # What a click on a reminder starts when the dev window isn't running.
    mkdir -p "$DEV/data/dbus-1/services"
    cat > "$DEV/data/dbus-1/services/dev.jaeho.Asst.Devel.service" <<SERVICE
[D-BUS Service]
Name=dev.jaeho.Asst.Devel
Exec=/usr/bin/env -u XDG_DATA_HOME XDG_DATA_DIRS=/usr/local/share:/usr/share XDG_CONFIG_HOME=$DEV/config XDG_STATE_HOME=$DEV/state ASST_DEVEL=1 ASST_NO_AUTOHIDE=1 GTK_A11Y=none GDK_DEBUG=no-portals $BIN/asst-gtk --gapplication-service
SERVICE
    hide_window
    # A bus that only starts this instance's services. Pointing
    # XDG_DATA_DIRS away is not enough: standard_session_servicedirs still
    # opens /usr/share and ~/.local, where a real install's units live.
    cat > "$DEV/session.conf" <<CONF
<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
  <type>session</type>
  <listen>unix:tmpdir=/tmp</listen>
  <auth>EXTERNAL</auth>
  <policy context="default">
    <allow send_destination="*" eavesdrop="true"/>
    <allow eavesdrop="true"/>
    <allow own="*"/>
  </policy>
  <servicedir>$DEV/data/dbus-1/services</servicedir>
</busconfig>
CONF
    # 9>&-: the bus and asstd outlive `up`; they must not hold its lock.
    (setsid nohup dbus-run-session --config-file="$DEV/session.conf" \
      -- "$0" inside > "$DEV/session.log" 2>&1 9>&- &)
    for _ in $(seq 50); do
      if [ -f "$DEV/bus" ] && (on_bus) 2>/dev/null; then echo "up: $DEV"; exit 0; fi
      sleep 0.2
    done
    echo "did not come up; see $DEV/session.log and $DEV/asstd.log" >&2
    exit 1
    ;;
  inside) inside ;;
  run) shift; on_bus; exec "$@" ;;
  asst) shift; on_bus; exec "$BIN/asst" "$@" ;;
  window)
    shift
    build
    on_bus
    pkill -f "^$BIN/asst-gtk( |$)" 2>/dev/null || true
    hide_window
    # Popovers stay open without keyboard focus (ASST_NO_AUTOHIDE).
    (env ASST_DEVEL=1 ASST_NO_AUTOHIDE=1 GTK_A11Y=none GDK_DEBUG=no-portals \
      setsid "$BIN/asst-gtk" "$@" > "$DEV/window.log" 2>&1 &)
    for _ in $(seq 60); do has_name dev.jaeho.Asst.Devel && { sleep 1; exit 0; }; sleep 0.25; done
    echo "the window did not come up; see $DEV/window.log" >&2
    exit 1
    ;;
  tray)
    on_bus
    has_name org.kde.StatusNotifierWatcher && exit 0
    (setsid /usr/bin/python3 "$REPO/scripts/sni-host.py" > "$DEV/tray.log" 2>&1 &)
    for _ in $(seq 40); do has_name org.kde.StatusNotifierWatcher && exit 0; sleep 0.1; done
    echo "the stand-in tray did not come up; see $DEV/tray.log" >&2
    exit 1
    ;;
  drive) action drive "$2" ;;
  click)
    on_bus
    gdbus call --session --dest org.freedesktop.Notifications --object-path /org/freedesktop/Notifications \
      --method dev.jaeho.Test.Click "$2" "$3" > /dev/null
    ;;
  keys)
    shift
    for k in "$@"; do
      mods="" key="$k"
      case "$k" in *+*) mods="${k%+*}"; key="${k##*+}"; mods="${mods//+/ }" ;; esac
      hyprctl eval "hl.dispatch(hl.dsp.send_shortcut({mods=\"${mods}\", key=\"${key}\", window=\"class:^dev.jaeho.Asst.Devel\$\"}))" > /dev/null
      sleep 0.05
    done
    ;;
  snap) action snapshot "$(realpath -m "$2")" ;;
  snap-popover) action snapshot-popover "$(realpath -m "$2")" ;;
  dump)
    on_bus
    out="$(realpath -m "${2:-$DEV/dump.json}")"
    rm -f "$out"
    action dump "$out"
    # The action only queues the write on the GTK loop.
    for _ in $(seq 40); do [ -f "$out" ] && break; sleep 0.05; done
    [ -f "$out" ] || { echo "dump did not write $out; see $DEV/window.log" >&2; exit 1; }
    [ -n "${2:-}" ] || cat "$out"
    ;;
  texts)
    on_bus
    out="$(realpath -m "${2:-$DEV/texts.json}")"
    rm -f "$out"
    action texts "$out"
    for _ in $(seq 40); do [ -f "$out" ] && break; sleep 0.05; done
    [ -f "$out" ] || { echo "texts did not write $out; see $DEV/window.log" >&2; exit 1; }
    [ -n "${2:-}" ] || cat "$out"
    ;;
  seed)
    on_bus
    seed_lists
    seed_tasks
    ;;
  reset)
    "$0" down --all
    rm -f "$DEV/config/asst/window.toml" "$DEV"/state/asst/asst.db*
    rm -rf "$DEV/notes"
    mkdir -p "$DEV/notes"
    # This instance's CalDAV collection only; other instances share Radicale.
    rm -rf "$RADICALE/data/collection-root/$(basename "$DEV")"
    clear_stale
    "$0" up
    "$0" seed
    ;;
  down)
    pkill -f "^$BIN/asst-gtk( |$)" 2>/dev/null || true
    pkill -f "^/usr/bin/python3 $REPO/scripts/(sni|notify)-host.py$" 2>/dev/null || true
    if [ "${2:-}" = "--all" ]; then
      # Stray debug binaries and this instance's Radicale. The window rule
      # from hide_window cannot be dropped (see its comment); it only
      # matches the devel app id and dies with a Hyprland config reload.
      pkill -f "$BIN/asst-gtk" 2>/dev/null || true
      pkill -f "$BIN/asstd" 2>/dev/null || true
      pkill -f "target/debug/asst-gtk" 2>/dev/null || true
      pkill -f "target/debug/asstd" 2>/dev/null || true
      pkill -f "$RADICALE/config" 2>/dev/null || true
    fi
    if [ -f "$DEV/bus" ]; then
      # The reply reads `(uint32 12345,)`.
      pid="$( (on_bus && gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
        --method org.freedesktop.DBus.GetConnectionUnixProcessID dev.jaeho.Asst.Daemon) 2>/dev/null \
        | sed -n 's/^(uint32 \([0-9][0-9]*\),)$/\1/p')" || true
      if [ -n "$pid" ] && [ "$(ps -o comm= -p "$pid")" = asstd ]; then
        kill "$pid"
      fi
      rm -f "$DEV/bus"
    fi
    ;;
  *) sed -n '2,27p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
