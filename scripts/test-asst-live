#!/bin/sh
# What asst-live must do: never run a missing binary after a failed first
# build; with a binary present, run it now and rebuild in the background;
# never run a name that is not asst/asst-gtk/asstd.
set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

mkdir -p "$tmp/bin" "$tmp/src/target/release"
# Cargo that always fails.
cat >"$tmp/bin/cargo" <<'EOF'
#!/bin/sh
exit 1
EOF
chmod +x "$tmp/bin/cargo"
# A binary that would leave a mark if anyone ran it.
cat >"$tmp/src/target/release/asst" <<'EOF'
#!/bin/sh
echo ran >>"$MARKER"
EOF
chmod +x "$tmp/src/target/release/asst"
touch "$tmp/src/Cargo.toml"

# Invoke as `asst`, the way PATH and the desktop file do.
ln -s "$here/asst-live" "$tmp/bin/asst"

export MARKER="$tmp/marker"
export ASST_SRC="$tmp/src"
export PATH="$tmp/bin:$PATH"
export XDG_STATE_HOME="$tmp/state"

# First install: no binary yet, failed build must not run anything.
rm -f "$tmp/src/target/release/asst"
if out=$("$tmp/bin/asst" 2>&1); then
  echo "FAIL: expected a non-zero exit when the first build fails" >&2
  exit 1
fi
if [ -e "$MARKER" ]; then
  echo "FAIL: something ran after a failed first build" >&2
  exit 1
fi
case $out in
  *"build failed"*) ;;
  *)
    echo "FAIL: no build-failed message; got: $out" >&2
    exit 1
    ;;
esac

# Wrong name: refuse, and do not build.
cat >"$tmp/bin/cargo" <<'EOF'
#!/bin/sh
echo built >>"$MARKER"
EOF
chmod +x "$tmp/bin/cargo"
ln -s "$here/asst-live" "$tmp/bin/nope"
if out=$("$tmp/bin/nope" 2>&1); then
  echo "FAIL: expected a non-zero exit for an unknown name" >&2
  exit 1
fi
if [ -e "$MARKER" ]; then
  echo "FAIL: built for a name that is not asst/asst-gtk/asstd" >&2
  exit 1
fi

# Binary present: run it now (args preserved) even if the background build fails.
cat >"$tmp/bin/cargo" <<'EOF'
#!/bin/sh
echo built >>"$MARKER"
sleep 0.2
exit 1
EOF
chmod +x "$tmp/bin/cargo"
cat >"$tmp/src/target/release/asst" <<'EOF'
#!/bin/sh
echo "args:$*" >>"$MARKER"
EOF
chmod +x "$tmp/src/target/release/asst"
: >"$MARKER"
if ! out=$("$tmp/bin/asst" one two 2>&1); then
  echo "FAIL: existing binary did not run: $out" >&2
  exit 1
fi
# The foreground is only the binary; cargo runs in the background.
grep -q '^args:one two$' "$MARKER" || {
  echo "FAIL: did not exec the binary with our args; got $(cat "$MARKER")" >&2
  exit 1
}
# Wait briefly for the background build to touch MARKER (and then fail).
sleep 0.5
grep -q '^built$' "$MARKER" || {
  echo "FAIL: did not kick a background rebuild; got $(cat "$MARKER")" >&2
  exit 1
}

# ASST_NO_REBUILD: run the binary, leave cargo alone.
: >"$MARKER"
ASST_NO_REBUILD=1 "$tmp/bin/asst" quiet >/dev/null 2>&1
sleep 0.5
grep -q '^args:quiet$' "$MARKER" || {
  echo "FAIL: ASST_NO_REBUILD did not run the binary; got $(cat "$MARKER")" >&2
  exit 1
}
if grep -q '^built$' "$MARKER"; then
  echo "FAIL: ASST_NO_REBUILD still rebuilt" >&2
  exit 1
fi

# After `make install`, the baked-in tree wins over $HOME/projects/asst,
# and the sentinel must not have eaten the fallback check.
sed "s|^DEFAULT_ROOT=\"@ROOT@\"|DEFAULT_ROOT=\"$tmp/src\"|" \
  "$here/asst-live" >"$tmp/bin/installed"
chmod 755 "$tmp/bin/installed"
# A copy under the name `asst`, not a symlink back at scripts/asst-live.
rm -f "$tmp/bin/asst"
cp "$tmp/bin/installed" "$tmp/bin/asst"
: >"$MARKER"
if ! out=$(HOME="$tmp/home" ASST_SRC= PATH="$tmp/bin:$PATH" \
  XDG_STATE_HOME="$tmp/state" MARKER="$MARKER" "$tmp/bin/asst" x 2>&1); then
  echo "FAIL: installed wrapper exited non-zero: $out" >&2
  exit 1
fi
grep -q '^args:x$' "$MARKER" || {
  echo "FAIL: installed wrapper did not use the baked-in tree; got $(cat "$MARKER")" >&2
  exit 1
}

# The source tree must still be the uninstalled template.
grep -q 'DEFAULT_ROOT="@ROOT@"' "$here/asst-live" || {
  echo "FAIL: scripts/asst-live lost its @ROOT@ sentinel" >&2
  exit 1
}

echo "asst-live: ok"
